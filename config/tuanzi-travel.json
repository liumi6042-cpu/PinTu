 "lines": {
  "water": [
   "这里的风有点咸，我的胡子被吹得歪歪的。",
   "水面亮晶晶的，我差点扑上去捉月亮。",
   "有只鸭子跟了我一路，它好像也想要小鱼干。",
   "我把爪子伸进水里，凉得我打了个喷嚏。",
   "船在晃，我也在晃，今天走路都是摇的。",
   "雾太大了，我只看得见自己的鼻子尖。",
   "捡到一颗会唱歌的贝壳，回去唱给你听。",
   "坐在岸边等日落，等着等着就睡着了。",
   "钓鱼的爷爷分了我一小块饭团，好香。",
   "浪一来我就跑，浪一走我又回去，玩了一下午。"
  ],
  "street": [
   "闻着香味走了三条街，原来是刚出锅的包子。",
   "有家店门口的铃铛和奶奶店里的一模一样。",
   "下雨了，我在屋檐下数路过的伞，数到了四十二。",
   "旧书摊的老板让我在书堆上睡了一个午觉。",
   "路灯一盏一盏亮起来，像在给我指路。",
   "电车叮叮地开过去，我追了一小段。",
   "糖画师傅给我画了一条鱼，可惜不能吃。",
   "巷子太窄了，我和一只大橘猫谁也不让谁。",
   "夜市好热闹，我的耳朵一直转来转去。",
   "钟楼敲了十二下，我数着数着就迷糊了。"
  ],
  "wild": [
   "山上的星星好多，比奶奶店里的拼图块还多。",
   "松鼠和我抢松果，最后我们一人一半。",
   "帐篷外面有萤火虫，我一晚上都在看它们。",
   "爬到最高的石头上，风把我的领巾吹起来了。",
   "草地软软的，我在上面打了好几个滚。",
   "瀑布的声音好大，我说话都要用喊的。",
   "踩到一朵蘑菇，它没生气，我也没生气。",
   "早上的雾把我变成了一团白白的猫。",
   "在小溪边洗了爪子，石头上留下一串脚印。",
   "牛在吃草，我在吃饭团，我们都很满足。"
  ],
  "town": [
   "车站的长椅晒得暖暖的，我坐了整整一下午。",
   "面包房的阿姨给了我一块面包边，脆脆的。",
   "邮局的台阶上，我替你看了好一会儿天。",
   "花店的花太香了，我连打了三个喷嚏。",
   "操场上的小朋友跟我玩了丢沙包。",
   "钟表铺里滴答滴答的，我差点跟着点头。",
   "镇口的大树下好凉快，我就不想走了。",
   "菜市场的鱼摊大叔冲我眨了眨眼。",
   "河边有人在钓鱼，我陪他等了很久很久。",
   "绕了一大圈，发现最想念的还是奶奶的小店。"
  ]
 },

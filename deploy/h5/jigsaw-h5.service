[Unit]
Description=Jigsaw Nook independent TapTap H5 gateway
After=network.target

[Service]
Type=simple
User=web-jigsaw
Group=web-jigsaw
WorkingDirectory=/srv/sites/jigsaw-h5/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/webapps/jigsaw-h5.env
ExecStart=/usr/local/bin/node server/h5-gateway.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/sites/jigsaw-h5/shared
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target

{
  "name": "jigsaw-nook-taptap-h5",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "local": "node scripts/start-local.mjs",
    "build": "vinext build",
    "build:server": "node scripts/build-server.mjs",
    "release": "node scripts/package-release.mjs",
    "release:upload": "node scripts/upload-release.mjs",
    "search:notify": "node scripts/notify-search-engines.mjs",
    "test:release": "node --test tests/release-package.test.mjs",
    "check:images": "node scripts/check-image-library.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "build:h5": "node scripts/build-h5.mjs",
    "h5:serve": "node server/h5-gateway.mjs",
    "test:h5": "node --test tests/h5-gateway.test.mjs tests/h5-ad-assistance.test.mjs && node --import ./tests/ts-register.mjs --test tests/h5-ads.test.mjs tests/h5-transport.test.mjs tests/h5-orientation.test.mjs",
    "release:h5-server": "node scripts/package-h5-server.mjs",
    "test:h5:acceptance": "node tests/h5-isolated-run.mjs",
    "build:mobile-server": "node scripts/build-mobile-server.mjs",
    "build:mobile": "node scripts/build-mobile-server.mjs && node scripts/build-h5.mjs",
    "build:mobile:shared": "node scripts/build-mobile-shared.mjs",
    "preview:mobile:shared": "node scripts/serve-mobile-shared.mjs",
    "test:mobile": "node --test tests/mobile-service.test.mjs && node --import ./tests/ts-register.mjs --test tests/mobile-room-client.test.mjs",
    "test:mobile:supplies": "node tests/mobile-supply-browser.mjs",
    "test:mobile:game": "node tests/mobile-game-browser.mjs",
    "mobile:preview": "node scripts/start-mobile.mjs",
    "test:mobile:responsive": "node tests/mobile-responsive-browser.mjs",
    "test:mobile:package": "node tests/mobile-package-smoke.mjs",
    "test:mobile:package-assets": "node tests/taptap-package-assets.mjs",
    "ui:pixels": "node scripts/build-pixel-ui.mjs",
    "check:ui-pixels": "node scripts/build-pixel-ui.mjs --check"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react-day-picker": "9.8.1",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}

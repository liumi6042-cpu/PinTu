[Unit]
Description=Jigsaw Nook puzzle website
After=network.target

[Service]
Type=simple
User=web-jigsaw
Group=web-jigsaw
WorkingDirectory=/srv/sites/jigsaw/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3103
Environment=VINEXT_TRUSTED_HOSTS=jigsawnook.online
Environment=VINEXT_TRUST_PROXY=1
EnvironmentFile=/etc/webapps/jigsaw.env
ExecStartPre=/usr/local/bin/node server/migrate.mjs
ExecStart=/usr/local/bin/node server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/sites/jigsaw/shared
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LimitNOFILE=65536
MemoryMax=900M
TasksMax=128

[Install]
WantedBy=multi-user.target

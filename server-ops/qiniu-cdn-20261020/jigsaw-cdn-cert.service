[Unit]
Description=Renew api.ymxc.top and reconcile its Qiniu certificate
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/bin/certbot renew --cert-name api.ymxc.top --quiet
ExecStart=/usr/bin/python3 /opt/jigsaw-cdn-cert/certificate_ops.py sync
TimeoutStartSec=1200
PrivateTmp=true
NoNewPrivileges=true

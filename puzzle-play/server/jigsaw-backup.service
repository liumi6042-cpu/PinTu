[Unit]
Description=Jigsaw Nook verified online database backup
After=jigsaw-web.service
[Service]
Type=oneshot
User=web-jigsaw
Group=web-jigsaw
WorkingDirectory=/srv/sites/jigsaw/current
EnvironmentFile=/etc/webapps/jigsaw.env
ExecStart=/usr/local/bin/node server/backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/sites/jigsaw/shared

# Copy to .env.beta for LOCAL testing. This file contains no credentials.
# Hosted values must be configured in the production runtime, not committed.
PUZZLE_OPERATOR_NAME=
PUZZLE_SUPPORT_EMAIL=
PUZZLE_FEEDBACK_ADMIN_URL=
# Comma-separated existing account IDs; no automatic administrator is created.
PUZZLE_ADMIN_IDS=
# Local default 0 = unlimited; set 24 to rehearse limited admission.
# Production requires an integer from 1 to 200 (default 24 is not a capacity guarantee).
PUZZLE_BETA_CAPACITY=24
PUZZLE_PUBLIC_ORIGIN=
# Set only after the corresponding actual review, never to bypass checks.
PUZZLE_PRIVACY_REVIEWED=false
PUZZLE_ASSETS_REVIEWED=false

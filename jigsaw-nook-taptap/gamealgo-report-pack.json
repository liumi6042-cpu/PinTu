{
  "schemaVersion": 2,
  "title": "拼图小窝数据看板",
  "milestones": [
    {
      "type": "new_user",
      "title": "新用户前期流程",
      "windowDays": 14,
      "entryMode": "cohortUsers",
      "points": [
        "进入大厅",
        "开始首局拼图",
        "完成首次拼合",
        "完成首局拼图",
        "使用补给或看广告",
        "开启任务礼包"
      ]
    },
    {
      "type": "global",
      "title": "全局核心流程",
      "windowDays": 119,
      "entryMode": "cohortUsers",
      "points": [
        "完成任意拼图",
        "通关故事1-1",
        "体验多人房间",
        "通关第一章",
        "解锁图包或合成装饰",
        "达到5级"
      ]
    }
  ],
  "events": {
    "level_start": {
      "fields": {
        "mode": {
          "path": "$.mode",
          "type": "string"
        },
        "pieces": {
          "path": "$.pieces",
          "type": "number"
        }
      }
    },
    "level_end": {
      "fields": {
        "mode": {
          "path": "$.mode",
          "type": "string"
        },
        "result": {
          "path": "$.result",
          "type": "string"
        },
        "pieces": {
          "path": "$.pieces",
          "type": "number"
        },
        "duration_sec": {
          "path": "$.duration_sec",
          "type": "number"
        }
      }
    }
  },
  "datasets": {
    "puzzle_starts_daily": {
      "type": "event",
      "fromEvent": "level_start",
      "groupBy": [
        "dt",
        "mode"
      ],
      "metrics": {
        "starts": {
          "agg": "count"
        },
        "users": {
          "agg": "count_distinct",
          "field": "userId"
        }
      }
    },
    "puzzle_mode_daily": {
      "type": "event",
      "fromEvent": "level_end",
      "groupBy": [
        "dt",
        "mode"
      ],
      "metrics": {
        "attempts": {
          "agg": "count"
        },
        "wins": {
          "agg": "count",
          "filter": {
            "field": "result",
            "op": "eq",
            "value": "win"
          }
        },
        "quits": {
          "agg": "count",
          "filter": {
            "field": "result",
            "op": "eq",
            "value": "quit"
          }
        },
        "duration_sec_sum": {
          "agg": "sum",
          "field": "duration_sec"
        },
        "users": {
          "agg": "count_distinct",
          "field": "userId"
        }
      }
    },
    "puzzle_pieces_daily": {
      "type": "event",
      "fromEvent": "level_end",
      "groupBy": [
        "dt",
        "pieces"
      ],
      "metrics": {
        "attempts": {
          "agg": "count"
        },
        "wins": {
          "agg": "count",
          "filter": {
            "field": "result",
            "op": "eq",
            "value": "win"
          }
        },
        "duration_sec_sum": {
          "agg": "sum",
          "field": "duration_sec"
        }
      }
    }
  },
  "groups": [
    {
      "id": "core",
      "title": "核心概览",
      "standard": "core.overview@1"
    },
    {
      "id": "versions",
      "title": "版本覆盖",
      "standard": "device.version_coverage@1"
    },
    {
      "id": "milestone_funnel",
      "title": "流程漏斗与流失定位",
      "standard": "milestone.funnel@1"
    },
    {
      "id": "puzzle_gameplay",
      "title": "拼图玩法表现",
      "selectors": [
        {
          "id": "mode",
          "label": "玩法模式",
          "type": "dimension",
          "allowAll": true
        }
      ],
      "views": [
        {
          "id": "starts_trend",
          "title": "每日开局次数趋势",
          "type": "line",
          "x": "dt",
          "y": "starts",
          "series": "mode",
          "data": {
            "dataset": "puzzle_starts_daily",
            "selectorBindings": {
              "mode": "mode"
            },
            "groupBy": [
              "dt",
              "mode"
            ],
            "metrics": {
              "starts": {
                "agg": "sum",
                "field": "starts"
              }
            }
          }
        },
        {
          "id": "completion_rate_trend",
          "title": "各模式每日完成率趋势",
          "type": "line",
          "x": "dt",
          "y": "win_rate",
          "series": "mode",
          "data": {
            "dataset": "puzzle_mode_daily",
            "selectorBindings": {
              "mode": "mode"
            },
            "groupBy": [
              "dt",
              "mode"
            ],
            "metrics": {
              "attempts": {
                "agg": "sum",
                "field": "attempts"
              },
              "wins": {
                "agg": "sum",
                "field": "wins"
              },
              "win_rate": {
                "formula": "wins / attempts"
              }
            }
          }
        },
        {
          "id": "mode_summary",
          "title": "区间玩法汇总",
          "type": "table",
          "data": {
            "dataset": "puzzle_mode_daily",
            "selectorBindings": {
              "mode": "mode"
            },
            "groupBy": [
              "mode"
            ],
            "metrics": {
              "attempts": {
                "agg": "sum",
                "field": "attempts"
              },
              "wins": {
                "agg": "sum",
                "field": "wins"
              },
              "win_rate": {
                "formula": "wins / attempts"
              },
              "total_duration_sec": {
                "agg": "sum",
                "field": "duration_sec_sum"
              },
              "avg_duration_sec": {
                "formula": "total_duration_sec / attempts"
              },
              "user_days": {
                "agg": "sum",
                "field": "users"
              }
            }
          },
          "orderBy": [
            {
              "field": "attempts",
              "direction": "desc"
            }
          ],
          "limit": 20
        },
        {
          "id": "pieces_summary",
          "title": "拼图片数难度分布",
          "type": "table",
          "data": {
            "dataset": "puzzle_pieces_daily",
            "groupBy": [
              "pieces"
            ],
            "metrics": {
              "attempts": {
                "agg": "sum",
                "field": "attempts"
              },
              "wins": {
                "agg": "sum",
                "field": "wins"
              },
              "win_rate": {
                "formula": "wins / attempts"
              },
              "total_duration_sec": {
                "agg": "sum",
                "field": "duration_sec_sum"
              },
              "avg_duration_sec": {
                "formula": "total_duration_sec / attempts"
              }
            }
          },
          "orderBy": [
            {
              "field": "pieces",
              "direction": "asc"
            }
          ],
          "limit": 20
        }
      ]
    },
    {
      "id": "retention",
      "title": "新用户留存",
      "standard": "retention.cohort@1"
    },
    {
      "id": "ltv",
      "title": "新用户 LTV",
      "standard": "revenue.ltv@1"
    },
    {
      "id": "revenue",
      "title": "收入表现",
      "standard": "revenue.placement@1"
    }
  ],
  "tabs": [
    {
      "id": "overview",
      "title": "概览",
      "groups": [
        "core",
        "versions"
      ]
    },
    {
      "id": "player_flow",
      "title": "玩家流程",
      "groups": [
        "milestone_funnel",
        "puzzle_gameplay"
      ]
    },
    {
      "id": "new_users",
      "title": "新用户",
      "groups": [
        "retention",
        "ltv"
      ]
    },
    {
      "id": "revenue",
      "title": "收入",
      "groups": [
        "revenue"
      ]
    }
  ]
}

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment
.env*
.dev.vars
.dev.vars.*

# deployment and generated files
.vercel
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

*.tsbuildinfo

# Runtime data, credentials and release archives never belong in source control.
/releases/
/data/
/backups/
*.sqlite
*.sqlite-*
*.sqlite3
*.db
*.db-*
*.key
*.pfx
*.p12
*.tar
*.tar.gz
*.tgz
*.zip
__pycache__/
*.pyc

# Independent project must not inherit another Sites project attachment.
/.openai/

# Generated by scripts/build-*.mjs and build-mobile-fonts.py; rebuilt on every build.
/public/pixel-ui/
/public/mobile-icons/*
!/public/mobile-icons/README.md
!/public/mobile-icons/b2-card-icons1023.png
!/public/mobile-icons/b2-card-icons1023.json
!/public/mobile-icons/b2-reward-cursors.png
/public/fonts/
/public/audio/

# Concept art and browser-test screenshots stay local; they are large and regenerated.
/docs/concepts/
/docs/verification/

# Shared media-store holds puzzle images & artwork masters outside Git.
/public/puzzles/
/content/artwork/

.claude/
